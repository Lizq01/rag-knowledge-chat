# ============================================================
# 知识库 RAG Agent · 环境变量模板
# 使用方法：把本文件复制一份，重命名为 .env，然后填入你的配置
# ============================================================

# ---------- LLM（任何 OpenAI 兼容接口，选一种即可）----------

# 示例：DeepSeek（推荐，便宜好用）
OPENAI_API_KEY=sk-在这里填你的Key
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# 示例：OpenAI 官方（要用官方就把上面三行注释掉，换成下面两行）
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini

# ---------- 向量化模型（本地运行，首次自动下载约 95MB）----------
# 默认使用 BGE 中文小模型；国内下载自动走 hf-mirror 镜像
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ---------- 检索参数 ----------
TOP_K=10              # 混合检索召回的候选数
RERANK_TOP_N=5        # 重排后送入 LLM 的片段数
CHUNK_SIZE=500        # 切分块大小（字符数）
CHUNK_OVERLAP=80      # 相邻块重叠字符数

# ---------- 向量索引后端（M2）----------
# auto  = 优先 FAISS，装不上自动退回 NumPy（推荐）
# faiss = 强制使用 FAISS（装不上直接报错）；numpy = 强制 NumPy 暴力检索
VECTOR_BACKEND=auto
# flat = IndexFlatIP 精确检索（结果与 NumPy 一致，只是更快）
# hnsw = IndexHNSWFlat 近似检索（数据量大时启用，用少量召回换亚线性查询）
FAISS_INDEX_TYPE=flat
FAISS_HNSW_M=32            # HNSW 图的连接数，越大越准越占内存
FAISS_HNSW_EF_SEARCH=64    # HNSW 查询期搜索宽度，越大越准越慢

# ---------- 重排后端（M2）----------
# auto           = Cross-Encoder 优先，加载失败自动降级 LLM 重排
# cross-encoder  = 只用本地模型（失败则降级为不重排）
# llm            = 只用大模型打分（M1 方案，有网络与 token 成本）
# none           = 不重排，直接按召回序截断（A/B 对比基线）
RERANK_BACKEND=auto
# fastembed 内置的 ONNX 重排模型；中文场景推荐下面两个之一
# BAAI/bge-reranker-v2-m3-int8（0.57GB，多语言，CPU 友好）／BAAI/bge-reranker-base（1.04GB）
RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8
RERANK_BATCH_SIZE=16       # Cross-Encoder 批大小
RERANK_MAX_CHARS=1500      # 单片段送入重排模型的最大字符数（防止长文本拖慢 CPU）

# ---------- LLM 调用 ----------
LLM_TIMEOUT=60        # 单次 LLM 调用超时（秒）
LLM_MAX_RETRIES=2     # 失败重试次数（指数退避 + 抖动）

# ---------- 可选扩展 ----------
# TAVILY_API_KEY=
