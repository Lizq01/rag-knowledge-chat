# ============================================================
# 知识库 RAG Agent · 环境变量模板
# 使用方法：把本文件复制一份，重命名为 .env，然后填入你的配置
# ============================================================

# ---------- LLM（任何 OpenAI 兼容接口，选一种即可）----------

# 示例：DeepSeek（推荐，便宜好用）
OPENAI_API_KEY=sk-在这里填你的Key
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# 示例：OpenAI 官方（要用官方就把上面三行注释掉，换成下面两行）
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini

# ---------- 向量化模型（本地运行，首次自动下载约 95MB）----------
# 默认使用 BGE 中文小模型；国内下载自动走 hf-mirror 镜像
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ---------- 检索参数 ----------
TOP_K=10              # 混合检索召回的候选数
RERANK_TOP_N=5        # 重排后送入 LLM 的片段数
CHUNK_SIZE=500        # 切分块大小（字符数）
CHUNK_OVERLAP=80      # 相邻块重叠字符数

# ---------- 可选扩展 ----------
# TAVILY_API_KEY=
